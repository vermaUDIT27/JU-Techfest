# ==============================================================================
# SANCHAYA (Civic Waste Operations Decision Support • Pune)
# Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# SQLite Database Location (defaults to server/data/wastewise.sqlite)
SQLITE_PATH=server/data/wastewise.sqlite

# Cryptographic Session Security (Minimum 16 characters required)
SESSION_SECRET=sanchaya-pune-secure-session-key-dev-2026!
SESSION_MAX_AGE_HOURS=8

# Driver OTP Configuration
# Set OTP_DEV_MODE=true for local development console logging.
# In production (NODE_ENV=production), OTP_DEV_MODE must be false.
OTP_DEV_MODE=true

# Incident Photo Upload Directory
UPLOAD_DIR=server/uploads/complaints

# ==============================================================================
# Development Officer Bootstrap Configuration (Used by npm run server:bootstrap)
# ==============================================================================
# Municipal Head Account (Citywide Directorate Scope)
BOOTSTRAP_OFFICER_IDENTIFIER=admin.commissioner
BOOTSTRAP_OFFICER_PASSWORD=JaipurClean#2026
BOOTSTRAP_OFFICER_NAME=Municipal Commissioner Pune
BOOTSTRAP_OFFICER_ROLE=municipal_head
BOOTSTRAP_OFFICER_WARD=

# Ward Supervisor Account (Ward 84 Scoped)
BOOTSTRAP_SUPERVISOR_IDENTIFIER=supervisor.ward84
BOOTSTRAP_SUPERVISOR_PASSWORD=Supervisor#Ward84
